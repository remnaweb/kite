[Unit]
Description=panel.vpn
After=network.target nss-lookup.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/panelvpn
EnvironmentFile=-/etc/panelvpn/panel.env
ExecStart=/usr/local/panelvpn/panel
Restart=always
RestartSec=3
LimitNOFILE=65535
LimitNPROC=65535

[Install]
WantedBy=multi-user.target
